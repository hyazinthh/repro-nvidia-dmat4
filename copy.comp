#version 450
// Loads matrix i as a whole dmat4 from a storage buffer and stores its 16
// components (memory order: column c, row r at 4 c + r) as doubles.
layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) readonly  buffer Matrices { dmat4  matrices[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Result   { double result[];   };

layout(push_constant) uniform Params { int count; };

void main()
{
    int i = int(gl_GlobalInvocationID.x);
    if (i < count)
    {
        dmat4 m = matrices[i];
        int o = 16 * i;
        result[o + 0]  = m[0][0]; result[o + 1]  = m[0][1]; result[o + 2]  = m[0][2]; result[o + 3]  = m[0][3];
        result[o + 4]  = m[1][0]; result[o + 5]  = m[1][1]; result[o + 6]  = m[1][2]; result[o + 7]  = m[1][3];
        result[o + 8]  = m[2][0]; result[o + 9]  = m[2][1]; result[o + 10] = m[2][2]; result[o + 11] = m[2][3];
        result[o + 12] = m[3][0]; result[o + 13] = m[3][1]; result[o + 14] = m[3][2]; result[o + 15] = m[3][3];
    }
}
